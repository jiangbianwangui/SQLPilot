# SQLPilot 环境变量示例
# 用法：复制本文件为 .env，填入你自己的值。.env 已被 .gitignore 忽略，不会提交。
#   cp .env.example .env        （macOS / Linux / Git Bash）
#   copy .env.example .env      （Windows cmd）

# ---------- 大模型（必需，任意 OpenAI 兼容接口）----------
# 推荐：硅基流动 SiliconFlow（国内，注册送额度，便宜）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct        # 也可换 deepseek-ai/DeepSeek-V3 等
# 备选 1：DeepSeek 官方（代码默认值）
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL_ID=deepseek-chat
# 备选 2：通义千问 DashScope（OpenAI 兼容模式）
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL_ID=qwen-plus
# 备选 3：本地 Ollama（无需真实 key，随便填一个非空值即可）
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL_ID=qwen2.5:7b
LLM_API_KEY=sk-在这里填你的key

# ---------- 目标数据库（可选，仅连真实 MySQL 时需要）----------
# 不填则使用代码内默认值；demo 模式走 SQLite 内存库，完全不读这几项。
# 生产环境请务必使用只读账号。
SQLPILOT_DB_HOST=127.0.0.1
SQLPILOT_DB_PORT=3306
SQLPILOT_DB_USER=root
SQLPILOT_DB_PASSWORD=
SQLPILOT_DB_NAME=stationery_inventory
