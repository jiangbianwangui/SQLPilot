# SQLPilot 环境变量示例
# 用法：复制本文件为 .env，填入你自己的值。.env 已被 .gitignore 忽略，不会提交。
#   cp .env.example .env        （macOS / Linux / Git Bash）
#   copy .env.example .env      （Windows cmd）

# ---------- 大模型（必需）----------
# 任何 OpenAI 兼容接口都行：DeepSeek / 通义 / Ollama 本地 …
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
# 本地 Ollama 示例（无需真实 key，随便填一个非空值即可）：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL_ID=qwen2.5:7b

# ---------- 目标数据库（可选，仅连真实 MySQL 时需要）----------
# 不填则使用代码内默认值；demo 模式走 SQLite 内存库，完全不读这几项。
# 生产环境请务必使用只读账号。
SQLPILOT_DB_HOST=127.0.0.1
SQLPILOT_DB_PORT=3306
SQLPILOT_DB_USER=root
SQLPILOT_DB_PASSWORD=
SQLPILOT_DB_NAME=stationery_inventory
